# --- Telegram ---
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=
# ID del canal/grupo donde se publica (ej. -1001234567890 para canales, o @nombre_del_canal si es público)
TELEGRAM_CHAT_ID=

# --- Mercado Libre ---
# Sitio de Mercado Libre a consultar (MLM = México)
ML_SITE_ID=MLM

# --- OAuth de Mercado Libre (ver scripts/ml_oauth_setup.py) ---
# CLIENT_ID y CLIENT_SECRET de tu aplicación en developers.mercadolibre.com.mx/apps
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# refresh_token inicial que te da ml_oauth_setup.py (se rota solo en cada corrida)
ML_REFRESH_TOKEN=

# --- Solo necesario si corres esto en GitHub Actions ---
# Personal Access Token de GitHub con permiso de escritura sobre "Secrets" del repo,
# para que el workflow pueda guardar el ML_REFRESH_TOKEN nuevo en cada corrida
# (el refresh_token de Mercado Libre es de un solo uso).
GH_PAT_SECRETS=
